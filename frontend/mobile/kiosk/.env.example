# Copy to `.env` before running. The real file is gitignored and must never be
# committed — it carries the backend's shared Basic credentials.
#
#   cp .env.example .env
#   flutter run

# Backend root, no trailing slash.
#
#   local (MAMP):  http://localhost:8888
#                  MAMP's document root is the backend itself, so the path stops
#                  at the port. On a physical tablet, forward it first:
#                      adb reverse tcp:8888 tcp:8888
#
#   live:          https://api.permedjat.com
#                  The bare host, with no suffix: Laravel serves the root and
#                  every client path already begins with /v1.
API_HOST = "http://localhost:8888"

# Basic auth in front of the API. The same pair the other Permedjat apps use.
# Note the value is `khawarizmie_medjat`, not `..._permedjat` — it is a
# credential the server checks, not a name, so the rename deliberately left it.
SECURITY_USER = ""
SECURITY_KEY = ""
