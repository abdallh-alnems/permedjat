# Backend root, no trailing slash. Laravel serves the root of api.permedjat.com
# and every path in this app already begins with /v1 — a /backend or
# /backend_medjet suffix 404s everything.
API_HOST = "https://api.permedjat.com"

# The shared app secret, sent as HTTP Basic in Authorization by every published
# Permedjat build. The operator's own session token is separate and goes in
# X-Admin-Token — see core/class/crud.dart. Without this pair the app-secret
# gate refuses every request before any guard runs.
#
# The value is `khawarizmie_medjat`, not `..._permedjat`: it is a credential the
# server checks, not a name, so the rename deliberately left it alone.
SECURITY_USER = "khawarizmie_medjat"
SECURITY_KEY = "Abdallh29512A"
